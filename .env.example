# =====================================================
# EMAD NET - TELEGRAM BOT
# =====================================================

NODE_ENV=production

PORT=3000


# =====================================================
# TELEGRAM
# =====================================================

BOT_TOKEN=PUT_YOUR_TELEGRAM_BOT_TOKEN_HERE

# Telegram numeric user ID of the owner/admin
ADMIN_TELEGRAM_ID=PUT_YOUR_TELEGRAM_ID_HERE


# =====================================================
# NOWPAYMENTS
# =====================================================

NOWPAYMENTS_API_KEY=PUT_YOUR_NOWPAYMENTS_API_KEY_HERE

NOWPAYMENTS_IPN_SECRET=PUT_YOUR_NOWPAYMENTS_IPN_SECRET_HERE

# Example:
# https://your-railway-domain.up.railway.app
PUBLIC_URL=https://YOUR-RAILWAY-DOMAIN


# Currency used for product prices
PRICE_CURRENCY=usd


# =====================================================
# VPN PROVISIONING
# =====================================================

# Optional.
# When payment becomes confirmed, bot can call your VPN API.
#
# Example:
# https://your-vpn-panel.example.com/api/create-subscription

VPN_PROVISION_URL=

VPN_PROVISION_SECRET=


# =====================================================
# BACKUP
# =====================================================

BACKUP_ENABLED=true

# Every day at 03:00 server time
BACKUP_CRON=0 3 * * *

# Keep last 14 backups
BACKUP_RETENTION=14


# =====================================================
# DATABASE
# =====================================================

DATABASE_FILE=./data/emadnet.db

BACKUP_DIR=./backups


# =====================================================
# ORDER SETTINGS
# =====================================================

PAYMENT_EXPIRE_MINUTES=60

# How many confirmations should be considered complete
# This is primarily informational; the payment provider
# determines the actual payment status.
REQUIRED_CONFIRMATIONS=1
